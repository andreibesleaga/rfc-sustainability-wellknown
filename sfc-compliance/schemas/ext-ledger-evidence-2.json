{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/andreibesleaga/rfc-sustainability-wellknown/main/sfc-compliance/schemas/ext-ledger-evidence-2.json",
  "title": "SFC 2 ledger-evidence-2 extension value",
  "description": "The value of the `ledger-evidence-2` extension (section 8.5). `network-offset-coverage` is required at network level and absent at operator level; the schema cannot tell the level. Unknown members are allowed. A wrong JSON type of a member makes this schema fail; the verifier then reads the member as absent (8.1).",
  "type": "object",
  "required": [
    "profile-version",
    "ledger-access-uri",
    "operators"
  ],
  "properties": {
    "profile-version": {
      "type": "string",
      "pattern": "^2\\.[0-9]+$"
    },
    "ledger-access-uri": {
      "$ref": "#/$defs/httpsUri"
    },
    "operators": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": [
          "operator",
          "origin",
          "energy-head",
          "carbon-head",
          "energy-events",
          "carbon-events",
          "kwh",
          "scope1-kgco2e",
          "scope2-kgco2e",
          "scope3-kgco2e",
          "offsets-kgco2e",
          "offset-coverage-every-period"
        ],
        "properties": {
          "operator": {
            "$ref": "#/$defs/did"
          },
          "origin": {
            "$ref": "#/$defs/host"
          },
          "energy-head": {
            "anyOf": [
              {
                "$ref": "#/$defs/hex64"
              },
              {
                "type": "null"
              }
            ]
          },
          "carbon-head": {
            "anyOf": [
              {
                "$ref": "#/$defs/hex64"
              },
              {
                "type": "null"
              }
            ]
          },
          "energy-events": {
            "type": "integer",
            "minimum": 0
          },
          "carbon-events": {
            "type": "integer",
            "minimum": 0
          },
          "kwh": {
            "type": "number",
            "minimum": 0,
            "exclusiveMaximum": 1000000000000000
          },
          "scope1-kgco2e": {
            "type": "number",
            "minimum": 0,
            "exclusiveMaximum": 1000000000000000
          },
          "scope2-kgco2e": {
            "type": "number",
            "exclusiveMaximum": 1000000000000000
          },
          "scope3-kgco2e": {
            "type": "number",
            "exclusiveMaximum": 1000000000000000
          },
          "offsets-kgco2e": {
            "type": "number",
            "minimum": 0,
            "exclusiveMaximum": 1000000000000000
          },
          "offset-coverage-every-period": {
            "type": "boolean"
          }
        }
      }
    },
    "network-offset-coverage": {
      "type": "boolean"
    }
  },
  "$defs": {
    "hex64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "64 lower-case hexadecimal characters (3.5 hex64)."
    },
    "did": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^did:[a-z0-9]+:(?:(?:[A-Za-z0-9._-]|%[0-9A-Fa-f]{2})*:)*(?:[A-Za-z0-9._-]|%[0-9A-Fa-f]{2})+$",
      "description": "A DID string, DID Core section 3.1 syntax (3.5 did)."
    },
    "host": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*$",
      "description": "A host name in A-label form, no scheme, port or path; upper case is accepted as input (3.5 host)."
    },
    "httpsUri": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^https://\\S+$",
      "description": "An absolute URI with scheme https (3.5 https-uri)."
    }
  }
}
