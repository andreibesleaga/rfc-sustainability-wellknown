{
  "name": "sustainability-wellknown-publisher",
  "version": "0.6.0",
  "description": "Reference publisher for /.well-known/sustainability-data (Internet-Draft draft-besleaga-sustainability-wellknown). Serves a draft-conformant document from pluggable metric sources (static/computed, Kepler/Prometheus, Climatiq, Salesforce Net Zero Cloud, Microsoft Sustainability Manager, Watershed).",
  "license": "BSD-3-Clause",
  "author": "Andrei Nicolae Besleaga",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andreibesleaga/rfc-sustainability-wellknown.git",
    "directory": "publisher"
  },
  "homepage": "https://github.com/andreibesleaga/rfc-sustainability-wellknown/tree/main/publisher#readme",
  "bugs": {
    "url": "https://github.com/andreibesleaga/rfc-sustainability-wellknown/issues"
  },
  "bin": {
    "sustainability-publisher": "bin/sustainability-publisher.js"
  },
  "files": [
    "LICENSE",
    "dist",
    "bin",
    "README.md",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "start": "node bin/sustainability-publisher.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "sustainability",
    "carbon",
    "well-known",
    "ietf",
    "csrd",
    "greenhouse-gas",
    "kepler",
    "climatiq",
    "co2js",
    "carbon.txt",
    "green-web-foundation"
  ],
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@tgwf/co2": "^0.19.0",
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "express": "^5.2.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
