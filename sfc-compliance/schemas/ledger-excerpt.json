{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/andreibesleaga/rfc-sustainability-wellknown/main/sfc-compliance/schemas/ledger-excerpt.json",
  "title": "SFC 2 ledger excerpt",
  "description": "One ledger read in the interchange format of section 5.8. `ledger[].event` is a 2.0 event or a 1.x event, `registry[]` a 2.0 or a 1.x entry (12.1 rules 1 and 6). Void acts and the checkpoint are closed objects. Unknown members are allowed (readers ignore them, 3.6 rule 3). Rules that need more than one member or more than one document (L4 to L12, Registry uniqueness, ledger order) are not stated here.",
  "type": "object",
  "required": [
    "excerpt-version",
    "profile-version",
    "network",
    "read-at",
    "registrar",
    "registry",
    "ledger"
  ],
  "properties": {
    "excerpt-version": {
      "const": 2
    },
    "profile-version": {
      "type": "string",
      "pattern": "^2\\.[0-9]+$"
    },
    "network": {
      "$ref": "#/$defs/host"
    },
    "read-at": {
      "$ref": "#/$defs/instant"
    },
    "registrar": {
      "type": "object",
      "required": [
        "jwk"
      ],
      "properties": {
        "jwk": {
          "$ref": "#/$defs/jwk"
        }
      }
    },
    "registry": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "anyOf": [
          {
            "type": "object",
            "required": [
              "operator",
              "origin",
              "network",
              "active",
              "keys",
              "nodeProfile",
              "sig"
            ],
            "properties": {
              "operator": {
                "$ref": "#/$defs/did"
              },
              "origin": {
                "$ref": "#/$defs/host"
              },
              "network": {
                "$ref": "#/$defs/host"
              },
              "active": {
                "type": "array",
                "minItems": 1,
                "maxItems": 100,
                "items": {
                  "type": "object",
                  "required": [
                    "from",
                    "to"
                  ],
                  "properties": {
                    "from": {
                      "$ref": "#/$defs/monthBound"
                    },
                    "to": {
                      "anyOf": [
                        {
                          "$ref": "#/$defs/monthBound"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  }
                }
              },
              "keys": {
                "type": "array",
                "minItems": 1,
                "maxItems": 100,
                "items": {
                  "type": "object",
                  "required": [
                    "jwk",
                    "validFromCommit",
                    "validToCommit"
                  ],
                  "properties": {
                    "jwk": {
                      "$ref": "#/$defs/jwk"
                    },
                    "validFromCommit": {
                      "$ref": "#/$defs/instant"
                    },
                    "validToCommit": {
                      "$ref": "#/$defs/instantOrNull"
                    }
                  }
                }
              },
              "nodeProfile": {
                "type": "object",
                "required": [
                  "hardwareClass",
                  "asicForbidden",
                  "purchasedAt",
                  "expectedRetireAt",
                  "reusePolicy"
                ],
                "properties": {
                  "hardwareClass": {
                    "enum": [
                      "general-purpose-x86",
                      "arm64-server",
                      "rpi-cluster",
                      "cloud-instance",
                      "accelerator-server"
                    ]
                  },
                  "asicForbidden": {
                    "const": true
                  },
                  "purchasedAt": {
                    "$ref": "#/$defs/fullDate"
                  },
                  "expectedRetireAt": {
                    "$ref": "#/$defs/fullDate"
                  },
                  "reusePolicy": {
                    "enum": [
                      "donate-to-education",
                      "resell-refurbished",
                      "recycle-WEEE-certified"
                    ]
                  },
                  "serviceLifeMonths": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              "version": {
                "type": "integer",
                "minimum": 1
              },
              "profile2From": {
                "$ref": "#/$defs/monthBound"
              },
              "sig": {
                "$ref": "#/$defs/sig"
              },
              "commit": false,
              "target": false,
              "read-at": false,
              "chains": false
            }
          },
          {
            "type": "object",
            "required": [
              "operator",
              "origin",
              "active",
              "keys"
            ],
            "properties": {
              "operator": {
                "$ref": "#/$defs/did"
              },
              "origin": {
                "$ref": "#/$defs/host"
              },
              "active": {
                "type": "array",
                "minItems": 1,
                "maxItems": 100,
                "items": {
                  "type": "object",
                  "required": [
                    "from",
                    "to"
                  ],
                  "properties": {
                    "from": {
                      "$ref": "#/$defs/fullDate"
                    },
                    "to": {
                      "anyOf": [
                        {
                          "$ref": "#/$defs/fullDate"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  }
                }
              },
              "keys": {
                "type": "array",
                "minItems": 1,
                "maxItems": 100,
                "items": {
                  "type": "object",
                  "required": [
                    "public-jwk",
                    "valid-from-commit",
                    "valid-to-commit"
                  ],
                  "properties": {
                    "public-jwk": {
                      "$ref": "#/$defs/jwk"
                    },
                    "valid-from-commit": {
                      "$ref": "#/$defs/instant"
                    },
                    "valid-to-commit": {
                      "$ref": "#/$defs/instantOrNull"
                    }
                  }
                }
              },
              "nodeProfile": {
                "type": "object",
                "required": [
                  "hardwareClass",
                  "asicForbidden",
                  "purchasedAt",
                  "expectedRetireAt",
                  "reusePolicy"
                ],
                "properties": {
                  "hardwareClass": {
                    "enum": [
                      "general-purpose-x86",
                      "arm64-server",
                      "rpi-cluster",
                      "cloud-instance",
                      "accelerator-server"
                    ]
                  },
                  "asicForbidden": {
                    "const": true
                  },
                  "purchasedAt": {
                    "$ref": "#/$defs/fullDate"
                  },
                  "expectedRetireAt": {
                    "$ref": "#/$defs/fullDate"
                  },
                  "reusePolicy": {
                    "enum": [
                      "donate-to-education",
                      "resell-refurbished",
                      "recycle-WEEE-certified"
                    ]
                  },
                  "serviceLifeMonths": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              "sig": false,
              "commit": false,
              "target": false,
              "read-at": false,
              "chains": false
            }
          }
        ]
      }
    },
    "ledger": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "commit",
          "hash",
          "event"
        ],
        "properties": {
          "commit": {
            "$ref": "#/$defs/instant"
          },
          "hash": {
            "$ref": "#/$defs/hex64"
          },
          "event": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "type",
                  "network",
                  "subject",
                  "actor",
                  "prev",
                  "ts",
                  "payload",
                  "sig"
                ],
                "properties": {
                  "type": {
                    "const": "EnergyAttested"
                  },
                  "network": {
                    "$ref": "#/$defs/host"
                  },
                  "subject": {
                    "$ref": "#/$defs/did"
                  },
                  "actor": {
                    "$ref": "#/$defs/did"
                  },
                  "prev": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/hex64"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "ts": {
                    "$ref": "#/$defs/instant"
                  },
                  "payload": {
                    "type": "object",
                    "required": [
                      "period",
                      "nodeCount",
                      "kWhConsumed",
                      "measurementMethod",
                      "evidence"
                    ],
                    "properties": {
                      "period": {
                        "type": "object",
                        "required": [
                          "start",
                          "end"
                        ],
                        "properties": {
                          "start": {
                            "$ref": "#/$defs/monthBound"
                          },
                          "end": {
                            "$ref": "#/$defs/monthBound"
                          }
                        },
                        "description": "One whole month; `end` is the next month's first instant (the pair is checked by rule L2)."
                      },
                      "nodeCount": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 999999999999999
                      },
                      "kWhConsumed": {
                        "$ref": "#/$defs/figure"
                      },
                      "measurementMethod": {
                        "enum": [
                          "hardware-metered",
                          "hardware-estimated",
                          "cloud-billing",
                          "third-party-modeled"
                        ]
                      },
                      "evidence": {
                        "$ref": "#/$defs/uriAbs"
                      },
                      "supersedes": {
                        "$ref": "#/$defs/hex64"
                      }
                    }
                  },
                  "sig": {
                    "$ref": "#/$defs/sig"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "type",
                  "network",
                  "subject",
                  "actor",
                  "prev",
                  "ts",
                  "payload",
                  "sig"
                ],
                "properties": {
                  "type": {
                    "const": "CarbonAttested"
                  },
                  "network": {
                    "$ref": "#/$defs/host"
                  },
                  "subject": {
                    "$ref": "#/$defs/did"
                  },
                  "actor": {
                    "$ref": "#/$defs/did"
                  },
                  "prev": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/hex64"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "ts": {
                    "$ref": "#/$defs/instant"
                  },
                  "payload": {
                    "type": "object",
                    "required": [
                      "period",
                      "scope2KgCO2e",
                      "scope3KgCO2e",
                      "gridIntensityRef",
                      "retirements",
                      "offsetsKgCO2e",
                      "netZero",
                      "evidence"
                    ],
                    "properties": {
                      "period": {
                        "type": "object",
                        "required": [
                          "start",
                          "end"
                        ],
                        "properties": {
                          "start": {
                            "$ref": "#/$defs/monthBound"
                          },
                          "end": {
                            "$ref": "#/$defs/monthBound"
                          }
                        },
                        "description": "One whole month; `end` is the next month's first instant (the pair is checked by rule L2)."
                      },
                      "scope1KgCO2e": {
                        "$ref": "#/$defs/figure"
                      },
                      "scope2KgCO2e": {
                        "$ref": "#/$defs/figure"
                      },
                      "scope2LocationKgCO2e": {
                        "$ref": "#/$defs/figure"
                      },
                      "scope3KgCO2e": {
                        "$ref": "#/$defs/figure"
                      },
                      "gridIntensityRef": {
                        "type": "string",
                        "maxLength": 4096
                      },
                      "retirements": {
                        "type": "array",
                        "maxItems": 100,
                        "items": {
                          "type": "object",
                          "required": [
                            "registry",
                            "reference",
                            "tonnesRetired",
                            "retiredAt",
                            "kg"
                          ],
                          "properties": {
                            "registry": {
                              "$ref": "#/$defs/httpsUri"
                            },
                            "reference": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 4096
                            },
                            "tonnesRetired": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 999999999999999
                            },
                            "retiredAt": {
                              "$ref": "#/$defs/instant"
                            },
                            "kg": {
                              "$ref": "#/$defs/figure"
                            },
                            "beneficiary": {
                              "type": "string",
                              "maxLength": 4096
                            }
                          }
                        }
                      },
                      "offsetsKgCO2e": {
                        "$ref": "#/$defs/figure"
                      },
                      "netZero": {
                        "type": "boolean"
                      },
                      "evidence": {
                        "$ref": "#/$defs/uriAbs"
                      },
                      "supersedes": {
                        "$ref": "#/$defs/hex64"
                      }
                    }
                  },
                  "sig": {
                    "$ref": "#/$defs/sig"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "type",
                  "subject",
                  "actor",
                  "prev",
                  "ts",
                  "payload",
                  "sig"
                ],
                "properties": {
                  "type": {
                    "enum": [
                      "EnergyAttested",
                      "CarbonAttested"
                    ]
                  },
                  "subject": {
                    "$ref": "#/$defs/did"
                  },
                  "actor": {
                    "$ref": "#/$defs/did"
                  },
                  "prev": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/hex64"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "ts": {
                    "$ref": "#/$defs/instant"
                  },
                  "payload": {
                    "type": "object",
                    "required": [
                      "period"
                    ],
                    "properties": {
                      "period": {
                        "type": "object",
                        "required": [
                          "from",
                          "to"
                        ],
                        "properties": {
                          "from": {
                            "type": "string"
                          },
                          "to": {
                            "type": "string"
                          }
                        }
                      },
                      "supersedes": {
                        "$ref": "#/$defs/hex64"
                      }
                    }
                  },
                  "sig": {
                    "type": "object",
                    "required": [
                      "alg",
                      "value"
                    ],
                    "properties": {
                      "alg": {
                        "type": "string"
                      },
                      "value": {
                        "type": "string"
                      }
                    }
                  }
                },
                "description": "A 1.x event (12.1 rule 1): `period` with `from` and `to`, no `network`. The dates are read by the verifier."
              }
            ]
          }
        }
      }
    },
    "voids": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": [
          "commit",
          "target",
          "sig"
        ],
        "additionalProperties": false,
        "properties": {
          "commit": {
            "$ref": "#/$defs/instant"
          },
          "target": {
            "$ref": "#/$defs/hex64"
          },
          "sig": {
            "$ref": "#/$defs/sig"
          }
        },
        "description": "A void act has exactly commit, target and sig (3.6 rule 3, 5.4)."
      }
    },
    "checkpoint": {
      "type": "object",
      "required": [
        "network",
        "read-at",
        "chains",
        "sig"
      ],
      "additionalProperties": false,
      "properties": {
        "network": {
          "$ref": "#/$defs/host"
        },
        "read-at": {
          "$ref": "#/$defs/instant"
        },
        "chains": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "type": "object",
            "required": [
              "operator",
              "type",
              "tip",
              "count"
            ],
            "properties": {
              "operator": {
                "$ref": "#/$defs/did"
              },
              "type": {
                "enum": [
                  "EnergyAttested",
                  "CarbonAttested"
                ]
              },
              "tip": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/hex64"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "count": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "registry-digest": {
          "$ref": "#/$defs/hex64"
        },
        "ledger-digest": {
          "$ref": "#/$defs/hex64"
        },
        "voids-digest": {
          "$ref": "#/$defs/hex64"
        },
        "sig": {
          "$ref": "#/$defs/sig"
        }
      },
      "description": "A checkpoint has only the members of 5.8 (3.6 rule 3)."
    },
    "notice": {
      "type": "string"
    }
  },
  "$defs": {
    "hex64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "64 lower-case hexadecimal characters (3.5 hex64)."
    },
    "did": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^did:[a-z0-9]+:(?:(?:[A-Za-z0-9._-]|%[0-9A-Fa-f]{2})*:)*(?:[A-Za-z0-9._-]|%[0-9A-Fa-f]{2})+$",
      "description": "A DID string, DID Core section 3.1 syntax (3.5 did)."
    },
    "host": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*$",
      "description": "A host name in A-label form, no scheme, port or path; upper case is accepted as input (3.5 host)."
    },
    "httpsUri": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^https://\\S+$",
      "description": "An absolute URI with scheme https (3.5 https-uri)."
    },
    "uriAbs": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:\\S+$",
      "description": "A URI with a scheme; a relative reference is invalid (3.5 uri-abs)."
    },
    "instant": {
      "type": "string",
      "maxLength": 64,
      "format": "date-time",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(\\.\\d+)?(Z|[+-]([01]\\d|2[0-3]):[0-5]\\d)$",
      "description": "An RFC 3339 date-time with upper-case T and Z, numeric offsets and fractions allowed (3.2 instant). Second 60 is rejected by this pattern and by the verifier (3.2)."
    },
    "instantOrNull": {
      "anyOf": [
        {
          "$ref": "#/$defs/instant"
        },
        {
          "type": "null"
        }
      ]
    },
    "monthBound": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-01T00:00:00Z$",
      "description": "The first instant of a month: YYYY-MM-01T00:00:00Z (3.5 month-bound)."
    },
    "fullDate": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$",
      "description": "RFC 3339 full-date (3.5 full-date)."
    },
    "figure": {
      "type": "number",
      "minimum": 0,
      "maximum": 999999999999999,
      "description": "A figure in kWh or kg: finite, not negative, below 10^15. The digit rules of 3.3 rule 2 (plain decimal, at most 15 digits, at most 6 after the point) cannot be stated for a JSON Schema number and are checked by rule L8."
    },
    "sig": {
      "type": "object",
      "required": [
        "alg",
        "value"
      ],
      "properties": {
        "alg": {
          "type": "string",
          "maxLength": 64
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$",
          "description": "base64url without padding, 86 characters (64 bytes). Only the canonical encoding is valid; the schema cannot tell, row 'encoding' of D3 or D2 does."
        }
      },
      "description": "{alg, value} (3.6). Ed25519 is the only algorithm; another alg fails L5 or D2."
    },
    "jwk": {
      "type": "object",
      "required": [
        "kty",
        "crv",
        "x"
      ],
      "properties": {
        "kty": {
          "const": "OKP"
        },
        "crv": {
          "const": "Ed25519"
        },
        "x": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$",
          "description": "The 43-character b64url public key."
        }
      }
    }
  }
}
