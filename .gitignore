temp
__pycache__/
.pytest_cache/
node_modules/
CHANGELOGS.md
coverage/
*.log
.env
.env.*
!.env.example
.DS_Store
*.tgz
.vscode/
.idea/
# Signing keys: keygen --out writes a private JWK; never commit one. Public halves live
# under temp/deploy-andreibesleaga.com/keys/ (temp/ is ignored above anyway).
*private*.jwk
*.private.json
*.pem
# ...except the test-only certificates and keys the suites read (a test CA and the RFC 8032 test key;
# consumer/test/fixtures/tls/make-fixtures.sh regenerates them). They sign nothing outside the tests.
!publisher/test/fixtures/*.pem
!consumer/test/fixtures/tls/*.pem

# sfc-compliance has no lockfile by design (its CI job runs npm install against the registry)
sfc-compliance/package-lock.json

# deploy/e2e/run.sh scratch files
deploy/e2e/.go-bin
deploy/e2e/.Caddyfile
deploy/e2e/.nginx/
deploy/e2e/.apache/
deploy/proxies/caddy/www
