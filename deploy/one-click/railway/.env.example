# Copy to .env (or set the same names as Railway variables). Required:
SD_TARGET=your.domain.example
SD_PROVIDER=Your Organisation (https://your.domain.example/contact)
SD_METHODOLOGY_URI=https://your.domain.example/sustainability/methodology
SD_PERIOD=2026-09
# How the figures were obtained: hardware-metered (a meter reading) | hardware-estimated | cloud-billing | third-party-modeled
SD_MEASUREMENT_METHOD=third-party-modeled
# At least one of these three:
SD_ENERGY_KWH=12.5
SD_CARBON_KGCO2E=3.06
SD_DISCLOSURE_URI=https://your.domain.example/sustainability
# Optional. Scopes are in kgCO2e, the same unit as SD_CARBON_KGCO2E (negative only for removals).
SD_SCOPE_1=
SD_SCOPE_2=
SD_SCOPE_3=
SD_TARGET_TYPE=origin
SD_RENEWABLE_PERCENT=
SD_CARBON_ACCOUNTING=
SD_UPDATED=
# Keep the signing key across restarts: generate one locally
# (npx -y -p sustainability-wellknown-publisher sustainability-publisher keygen --out key.jwk)
# and set this to the file's content as a secret. Never commit the file.
SD_SIGNING_KEY_JWK=
