<?xml version="1.0" encoding="utf-8"?>
<!-- IIS: rewrite the extensionless path to a .json file (URL Rewrite module) and set the headers on that file.
     <location> must be a direct child of <configuration>; the rewritten request takes that file's configuration.
     Not run in CI: load it once on a real IIS (or `appcmd list config`) before relying on it. -->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- A direct request for the .json file name answers 404: the declaration has one URL. -->
        <rule name="sustainability-data-no-json-url" stopProcessing="true">
          <match url="^\.well-known/sustainability-data\.json$" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>
        <rule name="sustainability-data" stopProcessing="true">
          <match url="^\.well-known/sustainability-data$" />
          <action type="Rewrite" url="/.well-known/sustainability-data.json" />
        </rule>
      </rules>
      <outboundRules>
        <rule name="sustainability-data-type" preCondition="declaration">
          <match serverVariable="RESPONSE_Content_Type" pattern=".*" />
          <action type="Rewrite" value="application/sustainability-data+json" />
        </rule>
        <preConditions>
          <preCondition name="declaration">
            <add input="{URL}" pattern="^/\.well-known/sustainability-data\.json$" />
          </preCondition>
        </preConditions>
      </outboundRules>
    </rewrite>
  </system.webServer>
  <location path=".well-known/sustainability-data.json">
    <system.webServer>
      <!-- Only GET and HEAD; IIS request filtering answers other methods with 404 unless configured for 405. -->
      <security>
        <requestFiltering>
          <verbs allowUnlisted="false">
            <add verb="GET" allowed="true" />
            <add verb="HEAD" allowed="true" />
          </verbs>
        </requestFiltering>
      </security>
      <httpProtocol>
        <customHeaders>
          <add name="X-Content-Type-Options" value="nosniff" />
          <add name="Access-Control-Allow-Origin" value="*" />
          <add name="Cache-Control" value="public, max-age=86400" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
